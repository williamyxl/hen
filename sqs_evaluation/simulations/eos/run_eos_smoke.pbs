#!/bin/bash -l
#PBS -N hen_eos_smoke
#PBS -q debug
# Allowed queues for HEN tests: debug | debug-scaling ONLY (never prod/capacity/etc.)
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=204:mpiprocs=1:ompthreads=1
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -k doe

# Smoke: EOS on one relaxed SQS frame, 1 XPU tile.
# From hen/: qsub sqs_evaluation/simulations/eos/run_eos_smoke.pbs

set -eo pipefail

module reset
module list

export http_proxy="http://proxy.alcf.anl.gov:3128"
export https_proxy="http://proxy.alcf.anl.gov:3128"
export ftp_proxy="http://proxy.alcf.anl.gov:3128"

export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_ENABLE_PCI_ID_DEVICE_ORDER=1
export ZE_AFFINITY_MASK=0

HEN=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
FXPU_PREFIX=/lus/flare/projects/MatSciAI/xiaoliyan/software/conda/envs/hen-xpu
# shellcheck disable=SC1091
source "${HEN}/scripts/activate_hen_xpu.sh"
export LD_LIBRARY_PATH="${FXPU_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
PY="$(command -v python)"

EVAL="${HEN}/sqs_evaluation"
STRUCT="${EVAL}/workflow_out/cell_opt_mc_sqs_20260730_032035/tasks/tile_00__sqs_000/relaxed.extxyz"
OUT="${EVAL}/workflow_out/eos_smoke_tile_00__sqs_000"
WORKER="${EVAL}/simulations/eos/eos_one.py"

cd "${EVAL}"
rm -rf "${OUT}"
mkdir -p "${OUT}"

echo "job_id=${PBS_JOBID:-local}  host=$(hostname)  out=${OUT}"
"${PY}" -c "import sys, torch; print(sys.executable); print('torch', torch.__version__)"

numactl --physcpubind=1-8 --membind=0 \
  "${PY}" "${WORKER}" \
    --structure "${STRUCT}" \
    --out-dir "${OUT}" \
    --task-id tile_00__sqs_000 \
    --volumes-scale 0.94 0.96 0.98 1.00 1.02 1.04 1.06

echo "EOS_SMOKE_OK"
"${PY}" -c "import json; print(json.dumps(json.load(open('${OUT}/result.json')), indent=2))"
