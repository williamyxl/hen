#!/bin/bash -l
#PBS -N hen_mu_n
#PBS -q debug
# Allowed queues for HEN tests: debug | debug-scaling ONLY (never prod/capacity/etc.)
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -l select=1:ncpus=204:mpiprocs=1:ompthreads=1
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -k doe

# Rebuild μ_N = E(N2)/2 under UMA task omat (same scale as metals), then merge.
# From hen/: qsub sqs_evaluation/simulations/cell_opt/build_mu_n_omat.pbs

set -eo pipefail

module reset
module list

export http_proxy="http://proxy.alcf.anl.gov:3128"
export https_proxy="http://proxy.alcf.anl.gov:3128"
export ftp_proxy="http://proxy.alcf.anl.gov:3128"

export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export ZE_ENABLE_PCI_ID_DEVICE_ORDER=1

HEN=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/hen
FXPU_PREFIX=/lus/flare/projects/MatSciAI/xiaoliyan/software/conda/envs/hen-xpu
# shellcheck disable=SC1091
source "${HEN}/scripts/activate_hen_xpu.sh"
export LD_LIBRARY_PATH="${FXPU_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
PY="$(command -v python)"

EVAL="${HEN}/sqs_evaluation"
SCRIPT="${EVAL}/simulations/cell_opt/build_elemental_refs.py"
UMA_MODEL="${HEN}/uma-cache/uma-s-1p2.pt"
OUT_DIR="${EVAL}/refs/uma"

mkdir -p "${OUT_DIR}/partials"
cd "${OUT_DIR}"

echo "job_id=${PBS_JOBID:-local}  host=$(hostname)  out_dir=${OUT_DIR}"
"${PY}" -c "import sys, torch; print(sys.executable); print('torch', torch.__version__)"

ZE_AFFINITY_MASK=0 numactl --physcpubind=1-8 --membind=0 \
  "${PY}" "${SCRIPT}" \
    --energy uma --device xpu --dtype float64 \
    --uma-model "${UMA_MODEL}" \
    --uma-task omat --uma-task-n2 omat \
    --fmax 0.01 --steps 300 \
    --out-dir "${OUT_DIR}" \
    --species N \
  > "${OUT_DIR}/tile_05_N.log" 2>&1 &

wait

"${PY}" "${SCRIPT}" --merge \
  --out-dir "${OUT_DIR}" \
  --out "${OUT_DIR}/elemental_refs.json"

echo "wrote ${OUT_DIR}/elemental_refs.json"
"${PY}" -c "import json; d=json.load(open('${OUT_DIR}/elemental_refs.json')); print('uma_task_n2', d.get('uma_task_n2')); print('per_atom_eV', d['per_atom_eV'])"
